<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="LechYTDLP.Views.MainPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:LechYTDLP.Views"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:components="using:LechYTDLP.Components"
      xmlns:controllers="using:LechYTDLP.Controllers"
      mc:Ignorable="d">

    <Page.Resources>
        <DataTemplate x:Key="ImageTemplate"
                      x:DataType="x:String">
            <ItemContainer HorizontalAlignment="Left"
                           Width="200"
                           Height="140">
                <TextBlock Text="{x:Bind}"
                           TextWrapping="WrapWholeWords" />
            </ItemContainer>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Button x:Name="ProcessingButton"
                Click="OnClick"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,16,16,0"
                Visibility="Collapsed">
            <Button.Content>
                <StackPanel Orientation="Horizontal"
                            Spacing="8">
                    <ProgressRing IsActive="True"
                                  Width="16"
                                  Height="16" />
                    <TextBlock Text="Processing URLs..."
                               x:Name="ProcessingButtonText" />
                </StackPanel>
            </Button.Content>
        </Button>

        <TeachingTip x:Name="ProcessingTeachingTip"
                     Target="{Binding ElementName=ProcessingButton}"
                     PreferredPlacement="Bottom"
                     IsLightDismissEnabled="False">
            <StackPanel Orientation="Vertical"
                        Spacing="8">
                <TextBlock x:Uid="ProcessingTeachingTipTitle"
                           Style="{StaticResource SubtitleTextBlockStyle}"
                           Foreground="{StaticResource AccentTextFillColorPrimaryBrush}" />
                <ListView x:Name="ProcessingListView"
                          SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="controllers:SearchRequest">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="{x:Bind Url}"
                                           Style="{StaticResource BodyTextBlockStyle}"
                                           Grid.Column="0"
                                           MaxLines="2"
                                           VerticalAlignment="Stretch" />
                                <!--<HyperlinkButton Text="{x:Bind Url}"
                                                 NavigateUri="{x:Bind UrlUri}"
                                                 Grid.Column="0"
                                                 VerticalAlignment="Stretch" />-->
                                <Button Click="OnClick"
                                        x:Name="ProcessingCancelButton"
                                        Grid.Column="1"
                                        VerticalAlignment="Stretch"
                                        Foreground="{StaticResource SystemFillColorCriticalBrush}"
                                        Tag="{x:Bind}">
                                    <FontIcon Glyph="&#xE711;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="HorizontalContentAlignment"
                                    Value="Stretch" />
                            <Setter Property="Padding"
                                    Value="0" />
                            <Setter Property="Margin"
                                    Value="0,6,0,6" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </StackPanel>
        </TeachingTip>


        <StackPanel Orientation="Vertical"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Spacing="16">

            <StackPanel.ChildrenTransitions>
                <EntranceThemeTransition FromVerticalOffset="50" />
                <RepositionThemeTransition IsStaggeringEnabled="False" />
            </StackPanel.ChildrenTransitions>

            <Grid HorizontalAlignment="Center"
                  RowSpacing="6"
                  VerticalAlignment="Stretch">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid ColumnSpacing="6"
                      Grid.Row="0"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="Lech"
                               Grid.Column="0"
                               TextWrapping="WrapWholeWords"
                               Style="{StaticResource TitleLargeTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
                    <TextBlock Text="YT-DLP"
                               x:Name="YTDLPText"
                               Grid.Column="1"
                               TextWrapping="WrapWholeWords"
                               FontWeight="Black"
                               Style="{StaticResource TitleLargeTextBlockStyle}"
                               Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Grid>
                <TextBlock FontFamily="Cascadia Code"
                           FontSize="12"
                           Grid.Row="1"
                           Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                           TextWrapping="WrapWholeWords"
                           Name="Subtitle"
                           x:Uid="LechYTdlpSubtitle"
                           TextAlignment="Center" />
            </Grid>

            <Grid MinWidth="300"
                  ColumnSpacing="8"
                  MaxWidth="500">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox TextChanged="TextChanged"
                         PlaceholderText="This will change..."
                         VerticalAlignment="Stretch"
                         Grid.Column="0"
                         Width="300"
                         IsTabStop="True"
                         Loaded="ElementLoaded"
                         KeyDown="OnKeyDown"
                         x:Name="LinkTextBox" />

                <Button Click="OnClick"
                        Grid.Column="1"
                        x:Name="PasteTextButton">
                    <SymbolIcon Symbol="Paste" />
                </Button>

                <Button Click="OnClick"
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        Style="{StaticResource AccentButtonStyle}"
                        IsEnabled="False"
                        x:Name="DownloadButton">
                    <SymbolIcon Symbol="Download" />
                </Button>
            </Grid>

            <Grid MinWidth="300"
                  MaxWidth="500">
                <ComboBox HorizontalAlignment="Stretch"
                          x:Name="PresetComboBox"
                          DisplayMemberPath="DisplayName"
                          SelectionChanged="SelectionChanged">
                </ComboBox>
            </Grid>
        </StackPanel>
    </Grid>
</Page>
